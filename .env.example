# Node HTTP port and SQLite database location.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/assessments.sqlite

# Sensitive database backups. Keep this outside the public web root.
BACKUP_DIRECTORY=./backups

# Exact browser origin allowed to call the API with cookies. Replace with HTTPS in production.
APP_ORIGIN=http://127.0.0.1:5173

# Development-only Vite /api proxy target. Production does not use this value.
API_PROXY_TARGET=http://127.0.0.1:3001

# Generate all values below with the interactive, history-safe commands in README.md.
# Never commit real credentials or reuse these variable names as literal secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_SECRET=

# Optional administrator login throttling (defaults shown).
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
